// Multiplayer room relay for Least Privilege Bird. Deploy: `npm i && npx wrangler deploy`
// (separate from the GitHub Pages deploy of the game itself).
{
  "name": "lpb-rooms",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }]
}
